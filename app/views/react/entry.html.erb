<!DOCTYPE html>
<html>
  <% if current_user %>
  <head>
    <%= stylesheet_link_tag "Page" %>
    <%= javascript_include_tag "Page" %>
  </head>
  <% else %>
  Inte inloggad. Gå <%= link_to "hit", :controller => "sessions", :action => "new" %> för att logga in.
  <% end %>
  <%= csrf_meta_tag %>
</html>
